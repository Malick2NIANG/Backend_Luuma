# ============================================================
#  LUUMA API — Variables d'environnement
# ============================================================

# Base de données
DATABASE_URL=

# App
NODE_ENV=
PORT=
APP_URL=
FRONTEND_URL=

# Auth (better-auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Stockage S3 (MinIO en local via docker-compose)
# Compatible S3 : pour passer sur R2/AWS un jour, seules ces variables
# changent — aucune ligne de code applicatif n'est à toucher.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=

# URL par laquelle les clients atteignent le stockage.
# En dev sur un vrai téléphone, remplacer localhost par l'IP LAN de la machine.
S3_PUBLIC_URL=

# Durée de validité des URLs présignées, en secondes.
S3_PRESIGN_UPLOAD_TTL=
S3_PRESIGN_DOWNLOAD_TTL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Wave (paiements Sénégal)
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=

# Email (Nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Connexion Google (console Google Cloud > Identifiants > ID client OAuth)
# URI de redirection à déclarer : {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envoi des codes par SMS. Tant que cette clé est vide, le canal SMS est
# proposé dans l'app mais désactivé, et les codes partent par email.
SMS_PROVIDER_API_KEY=

# Expo Push Notifications
EXPO_ACCESS_TOKEN=

# Taux de change EUR -> XOF
# Parité fixe par convention monétaire, pas un taux de marché : aucune API
# externe n'est nécessaire. Modifiable ici si la parité venait à changer.
EUR_TO_XOF_RATE=

# Durée de l'élévation vers l'espace d'administration, en minutes.
#
# Non renseignée, l'élévation dure autant que la session (30 jours) : un seul
# code à la première entrée. Confortable, mais elle ne protège alors que du vol
# de mot de passe — pas d'un poste laissé ouvert.
#
# La resserrer est l'affaire d'une ligne : 30 reproduit le comportement des
# consoles d'administration sérieuses (GitHub, AWS). L'élévation ne peut de
# toute façon jamais survivre à la session qui la porte.
# ADMIN_ELEVATION_TTL_MINUTES=30

# Commission Luuma, en % du sous-total produits.
# Ne s'applique pas aux frais de port : ceux-ci reviennent entièrement au GP.
PLATFORM_FEE_PERCENT=
