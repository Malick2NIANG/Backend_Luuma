{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node10",
    // Une application ne publie pas de types : personne n'importe ce paquet.
    // À `true` (valeur du gabarit NestJS), l'émission de .d.ts échoue sur le
    // type inféré de `auth`, qui référence un zod imbriqué dans better-auth
    // sans chemin d'import stable (TS2742).
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2021",
    "lib": ["ES2021"],
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  },
  "exclude": ["node_modules", "dist", "test"]
}
