{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node10",
    // Une application ne publie pas de types : personne n'importe ce paquet.
    // À `true` (valeur du gabarit NestJS), l'émission de .d.ts échoue sur le
    // type inféré de `auth`, qui référence un zod imbriqué dans better-auth
    // sans chemin d'import stable (TS2742).
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2021",
    "lib": ["ES2021"],
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    // Le cache incrémental vit DANS dist/, et c'est ce qui règle une panne
    // récurrente : `nest-cli.json` demande `deleteOutDir`, donc chaque
    // démarrage vide dist/ — mais le cache, posé à la racine, survivait et
    // affirmait à TypeScript que tout était déjà compilé. Résultat : plus
    // aucun fichier émis, et l'API refusait de démarrer sur
    // « Cannot find module dist/main », sans la moindre erreur de
    // compilation pour l'expliquer.
    //
    // Rangé ici, le cache est supprimé en même temps que ce qu'il décrit.
    // Les deux ne peuvent donc plus se contredire.
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test", "prisma", "scripts"]
}
